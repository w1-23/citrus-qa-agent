[Unit]
Description=CitrusQA Cloudflare Tunnel
After=network-online.target citrusqa.service
Wants=network-online.target

[Service]
Type=simple
User=wangziqiang
Group=wangziqiang
EnvironmentFile=/home/WZQ/CitrusQA/agent/state/cloudflare-tunnel.env
ExecStart=/home/WZQ/CitrusQA/04_脚本_scripts/cloudflared tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/WZQ/CitrusQA

[Install]
WantedBy=multi-user.target
